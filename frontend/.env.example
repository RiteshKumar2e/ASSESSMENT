# Frontend configuration (Vite). Copy to .env and adjust.
# Every VITE_* value is compiled into the public JavaScript bundle: never put secrets here.

# Base URL of the API. Leave empty when the API is on the same origin:
# in dev (Vite proxies /api) or when FastAPI serves the built app.
# Set it when the frontend is hosted separately, e.g. https://api.example.com
VITE_API_BASE_URL=

# Dev server only: where Vite forwards /api requests.
# Use 127.0.0.1 rather than localhost (Node prefers IPv6 for localhost).
VITE_PROXY_TARGET=http://127.0.0.1:8001

# Verified production URL, e.g. https://example.com. When set, the build adds canonical
# URLs, absolute Open Graph image URLs and sitemap.xml. Leave empty until deployed.
VITE_SITE_URL=https://assessment-seven-beta.vercel.app

# Shown on the Privacy and Terms pages and in the footer when set. Leave empty rather
# than inventing values; the legal pages then show "Owner to complete" markers.
VITE_CONTACT_EMAIL=
VITE_OPERATOR_NAME=
