# Backend configuration. Copy to .env and adjust; every value has a sensible default.

# Port used by Docker (docker-compose.yml). For local runs pass --port to uvicorn.
PORT=8000

# Comma-separated list of allowed browser origins, or * for any.
# The deployed frontend plus the local dev server. Use * only for local experiments.
CORS_ORIGINS=https://assessment-seven-beta.vercel.app,http://localhost:5173

# Where the January 2026 data snapshot lives (relative to backend/ or absolute).
SNAPSHOT_PATH=data/snapshot.json

# Folder with the built React app. FastAPI serves it when the folder exists.
STATIC_DIR=static

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Send Strict-Transport-Security. Enable only when the site is served over HTTPS.
ENABLE_HSTS=false
